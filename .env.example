# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI,
# use the "Session pooler" one). Leave unset to use a local SQLite file for testing.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Same values you type into the website's "Set up connection" form
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional, only for projects still using the legacy JWT secret
SUPABASE_JWT_SECRET=

# Website origins allowed to call this API (comma separated)
CORS_ORIGINS=https://osteocare-ai-mobility-monitor.packedsesame1.chatgpt.site,http://localhost:5173
